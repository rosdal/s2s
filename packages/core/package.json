    "@jridgewell/trace-mapping": "^0.3.31",
    "@wakaru/unminify": "0.2.2",
    "draco3dgltf": "1.5.9",
    "meshoptimizer": "1.3.0",
    "oxc-parser": "^0.159.0",
    "p-limit": "^7.3.3",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "robots-parser": "^3.0.1",
    "semver": "^7.8.6",
    "tldts": "^7.5.5",
